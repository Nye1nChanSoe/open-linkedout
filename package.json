{
  "name": "open-linkedout",
  "author": "nye1nchansoe",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm run setup:extractor && npm run setup:models",
    "setup:extractor": "uv venv .venv && uv pip install --python .venv restruct-cv==0.2.3",
    "setup:models": "RESTRUCT_MODELS_DIRECTORY=\"$PWD/models\" ./.venv/bin/restruct --install-models",
    "scheduler": "tsx src/scheduler/main.ts",
    "scheduler:documents": "tsx src/scheduler/documents-main.ts",
    "db:migrate": "tsx database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "scrape:search": "tsx src/scraper/main.ts",
    "scrape:detail": "tsx src/scraper/detail-page.ts",
    "resume:import": "tsx src/commands/resume-import.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
