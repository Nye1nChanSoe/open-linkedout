{
  "name": "open-linkedout",
  "author": "nye1nchansoe",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm run setup:extractor && npm run setup:models",
    "setup:extractor": "uv venv .venv && uv pip install --python .venv restruct-cv==0.2.3",
    "setup:models": "RESTRUCT_MODELS_DIRECTORY=\"$PWD/models\" ./.venv/bin/restruct --install-models",
    "app": "tsx src/main.ts",
    "db:migrate": "tsx database/migrate.ts",
    "typecheck": "tsc --noEmit",
    "scrape:discovery": "tsx src/commands/scrape.discovery-run.ts",
    "scrape:detail": "tsx src/commands/scrape.detail.ts",
    "resume:import": "tsx src/commands/resume.import.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "^13.0.1",
    "hono": "^4.13.7",
    "parse5": "^8.0.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
